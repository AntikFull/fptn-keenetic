#!/bin/sh

ENABLED=no
PROCS=fptn-client-cli
PROC=/opt/bin/fptn-client-cli
DESC="fptn-client"
CONF=/opt/etc/fptn-client.conf

if [ -f "$CONF" ]; then
    . "$CONF"
fi

if [ "$ENABLED" != "yes" ]; then
    exit 0
fi

if [ -z "$TOKEN" ]; then
    echo "FPTN token is empty in $CONF"
    exit 1
fi

IFNAME="${TUN_INTERFACE:-opkgtun1}"
MTU="${TUN_MTU:-1360}"
# Адрес туннеля. Должен совпадать с тем, что install.sh сообщает ndm: получатель
# входящих пакетов переписывается клиентом именно в это значение, и ndm
# транслирует в него же трафик локальной сети — при расхождении conntrack не
# сопоставит ответы и обратного трафика не будет.
TUN_IP="${TUN_ADDRESS:-10.0.0.1}"

# Логи пишем на накопитель Entware, а не в /var/log (это tmpfs, т.е. ОЗУ роутера)
FPTN_LOG_DIR="${FPTN_LOG_DIR:-/opt/var/log/fptn}"
FPTN_LOG_MAX_SIZE_MB="${FPTN_LOG_MAX_SIZE_MB:-1}"
FPTN_LOG_MAX_FILES="${FPTN_LOG_MAX_FILES:-2}"
export FPTN_LOG_DIR FPTN_LOG_MAX_SIZE_MB FPTN_LOG_MAX_FILES
mkdir -p "$FPTN_LOG_DIR" 2>/dev/null || true

# Ожидание сети перед стартом.
#
# Клиент до создания туннеля должен разобрать токен, отрезолвить хост, выполнить
# TLS-логин и получить адрес DNS. Любая из этих операций при отсутствии WAN
# завершается выходом из процесса, и rc.func сообщает `exit code 255` — ровно
# это и видно в логе роутера при загрузке, рядом с "S60wdtt: PPPoE not ready":
#     [I] root: Failed to start fptn-client from .
#     [E] ndm: Opkg::Manager: /opt/etc/init.d/S53fptn-client: exit code 255.
# Ждём появления маршрута по умолчанию, но не бесконечно: init-скрипты
# KeeneticOS выполняются последовательно, и долгая пауза здесь задержит запуск
# всего, что идёт после. Не дождались — выходим с нулём (не 255), дальше
# подхватит fptn-watchdog.sh.
WAIT_NETWORK_SECONDS="${FPTN_WAIT_NETWORK:-45}"

wait_for_network() {
    _n=0
    while [ "$_n" -lt "$WAIT_NETWORK_SECONDS" ]; do
        if ip route show default 2>/dev/null | grep -q "^default"; then
            return 0
        fi
        _n=$((_n + 1))
        sleep 1
    done
    return 1
}

case "$1" in
    start|restart)
        if ! wait_for_network; then
            echo "Сеть не поднялась за ${WAIT_NETWORK_SECONDS} с. Старт отложен, повтор выполнит watchdog."
            exit 0
        fi
        ;;
esac

# MTU и адрес задаёт сам клиент, чтобы у интерфейса был единственный владелец
# настроек
ARGS="--access-token ${TOKEN} --tun-interface-name ${IFNAME} --tun-interface-ip ${TUN_IP} --mtu-size ${MTU} --disable-routing"

if [ -n "$PREFERRED_SERVER" ]; then
    FIRST_SERVER=$(echo "$PREFERRED_SERVER" | cut -d',' -f1 | tr -d ' ')
    if [ -n "$FIRST_SERVER" ]; then
        SERVERS_FILE="/opt/etc/fptn-servers.json"
        if [ -f "$SERVERS_FILE" ]; then
            SRV_HOST=$(grep -A 2 "\"name\": \"$FIRST_SERVER\"" "$SERVERS_FILE" 2>/dev/null | grep '"host"' | cut -d'"' -f4)
            SRV_PORT=$(grep -A 3 "\"name\": \"$FIRST_SERVER\"" "$SERVERS_FILE" 2>/dev/null | grep '"port"' | tr -dc '0-9')
            PORT_TO_CHECK="${SRV_PORT:-443}"
            if [ -n "$SRV_HOST" ]; then
                if curl -s -k --connect-timeout 2 "https://${SRV_HOST}:${PORT_TO_CHECK}" >/dev/null 2>&1; then
                    ARGS="${ARGS} --preferred-server ${FIRST_SERVER}"
                else
                    echo "Сервер ${FIRST_SERVER} [${SRV_HOST}] недоступен. Автоматическое переключение на автовыбор."
                fi
            else
                ARGS="${ARGS} --preferred-server ${FIRST_SERVER}"
            fi
        else
            ARGS="${ARGS} --preferred-server ${FIRST_SERVER}"
        fi
    fi
fi

# Прежние версии этого скрипта добавляли правила через "iptables -I" при каждом
# запуске и никогда их не удаляли, поэтому у существующих установок цепочки
# заполнены дубликатами. Вычищаем их один раз перед стартом.
# NAT и подгонку MSS дальше выполняет сам ndm (см. "ip tcp adjust-mss pmtu").
cleanup_legacy_iptables() {
    _iter=0
    while [ "$_iter" -lt 20 ]; do
        _removed=0
        iptables -t nat -D POSTROUTING -o "${IFNAME}" -j MASQUERADE 2>/dev/null && _removed=1
        iptables -D FORWARD -o "${IFNAME}" -j ACCEPT 2>/dev/null && _removed=1
        iptables -D FORWARD -i "${IFNAME}" -j ACCEPT 2>/dev/null && _removed=1
        iptables -t mangle -D POSTROUTING -o "${IFNAME}" -p tcp \
            --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null && _removed=1
        [ "$_removed" = "0" ] && break
        _iter=$((_iter + 1))
    done
    return 0
}

# Вызываем напрямую, а не через PRECMD: разные версии Entware rc.func трактуют
# PRECMD по-разному (где-то как отдельную команду, где-то как префикс запуска).
case "$1" in
    start|restart) cleanup_legacy_iptables ;;
esac

# Адрес и MTU туннеля назначает сам клиент (см. --tun-interface-ip и --mtu-size
# выше). Здесь остаётся только то, чего клиент не делает: приоритет интерфейса
# для ndm и access-list, который KeeneticOS удаляет автоматически при простое.
#
# POSTCMD обязан быть ОДНИМ словом без кавычек, аргументов и перенаправлений:
# rc.func подставляет его как `$POSTCMD` без eval, и всё остальное разъезжается
# по аргументам. Прежний вариант с четырьмя `ndmc -c '...'` в одной строке
# приводил к `no such command: 'interface` и не настраивал интерфейс вообще.
PRECMD=""
PREARGS=""
POSTCMD="/opt/bin/fptn-ndm-setup.sh"
PATH=/opt/sbin:/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

. /opt/etc/init.d/rc.func

