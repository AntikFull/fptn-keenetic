#!/bin/sh

ENABLED=no
PROCS=fptn-client-cli
PROC=/opt/bin/fptn-client-cli
DESC="fptn-client"
CONF=/opt/etc/fptn-client.conf

if [ -f "$CONF" ]; then
    . "$CONF"
fi

if [ "$ENABLED" != "yes" ]; then
    exit 0
fi

if [ -z "$TOKEN" ]; then
    echo "FPTN token is empty in $CONF"
    exit 1
fi

IFNAME="${TUN_INTERFACE:-opkgtun1}"
ARGS="--access-token ${TOKEN} --tun-interface-name ${IFNAME} --disable-routing"

if [ -n "$PREFERRED_SERVER" ]; then
    ARGS="${ARGS} --preferred-server ${PREFERRED_SERVER}"
fi

KTUN=$(echo "$IFNAME" | sed -E 's/opkgtun([0-9]+)/OpkgTun\1/i')
PRECMD=""
PREARGS=""
POSTCMD="ndmc -c 'interface ${KTUN} ip mtu 1360' >/dev/null 2>&1; ndmc -c 'interface ${KTUN} up' >/dev/null 2>&1; ip link set dev ${IFNAME} mtu 1360 2>/dev/null || true; ip addr add 10.0.0.1/8 dev ${IFNAME} 2>/dev/null || true; iptables -t nat -C POSTROUTING -o ${IFNAME} -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -o ${IFNAME} -j MASQUERADE 2>/dev/null; iptables -C FORWARD -o ${IFNAME} -j ACCEPT 2>/dev/null || iptables -A FORWARD -o ${IFNAME} -j ACCEPT 2>/dev/null; iptables -C FORWARD -i ${IFNAME} -j ACCEPT 2>/dev/null || iptables -A FORWARD -i ${IFNAME} -j ACCEPT 2>/dev/null; iptables -t mangle -C POSTROUTING -o ${IFNAME} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || iptables -t mangle -A POSTROUTING -o ${IFNAME} -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true"
PATH=/opt/sbin:/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

. /opt/etc/init.d/rc.func

